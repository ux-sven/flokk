# Hentes fra Supabase-prosjektet: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<prosjekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Brukes til absolutte lenker (invitasjoner, innlogging)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Push-varsler: generer med `npm run vapid` (se docs/push-varsler.md)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
